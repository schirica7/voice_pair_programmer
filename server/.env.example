# LiveKit
LIVEKIT_URL=
LIVEKIT_API_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_AGENT_NAME=voice-pair-programmer

# LiveKit Inference
LIVEKIT_STT_MODEL=elevenlabs/scribe_v2_realtime
LIVEKIT_STT_LANGUAGE=en
LIVEKIT_LLM_MODEL=openai/gpt-5.5
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# macOS ffmpeg mic capture
# Run: ffmpeg -f avfoundation -list_devices true -i ""
# Attempting to connect to current audio device
FFMPEG_AVFOUNDATION_INPUT=none:default
