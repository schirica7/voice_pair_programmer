# LiveKit
LIVEKIT_URL=
LIVEKIT_API_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_AGENT_NAME=voice-pair-programmer

# LiveKit Inference
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=en-US
LIVEKIT_STT_MODEL_OPTIONS={}
LIVEKIT_STT_FALLBACK=["deepgram/flux-general"]
LIVEKIT_STT_MAX_RETRY=8
LIVEKIT_STT_RETRY_INTERVAL_MS=1000
LIVEKIT_STT_TIMEOUT_MS=15000
LIVEKIT_LLM_MODEL=openai/gpt-5.5
LIVEKIT_LLM_MAX_RETRY=4
LIVEKIT_LLM_RETRY_INTERVAL_MS=1000
LIVEKIT_LLM_TIMEOUT_MS=15000
LIVEKIT_TTS_MODEL=elevenlabs/eleven_turbo_v2_5
LIVEKIT_TTS_VOICE=cgSgspJ2msm6clMCkdW9
LIVEKIT_TTS_MAX_RETRY=4
LIVEKIT_TTS_RETRY_INTERVAL_MS=1000
LIVEKIT_TTS_TIMEOUT_MS=15000
LIVEKIT_MAX_UNRECOVERABLE_ERRORS=8
LIVEKIT_USER_AWAY_TIMEOUT_SECONDS=null

# LiveKit agent worker startup
# Keep one job runner warm in dev so the first call does not spend its whole timeout booting Node.
LIVEKIT_AGENT_NUM_IDLE_PROCESSES=1
LIVEKIT_AGENT_INITIALIZE_PROCESS_TIMEOUT_MS=60000
LIVEKIT_AGENT_SHUTDOWN_PROCESS_TIMEOUT_MS=60000

# LiveKit turn handling
# Keep this explicit while tuning latency. Lower endpointing delays reduce latency but can cut off long pauses.
LIVEKIT_TURN_DETECTION=stt
LIVEKIT_ENDPOINTING_MODE=fixed
LIVEKIT_ENDPOINTING_MIN_DELAY_MS=250
LIVEKIT_ENDPOINTING_MAX_DELAY_MS=1200
LIVEKIT_INTERRUPTION_ENABLED=true
LIVEKIT_INTERRUPTION_MODE=adaptive
LIVEKIT_INTERRUPTION_MIN_DURATION_MS=200
LIVEKIT_INTERRUPTION_MIN_WORDS=0
LIVEKIT_FALSE_INTERRUPTION_TIMEOUT_MS=1000
LIVEKIT_RESUME_FALSE_INTERRUPTION=false
LIVEKIT_DISCARD_AUDIO_IF_UNINTERRUPTIBLE=false
LIVEKIT_INTERRUPTION_BACKCHANNEL_BOUNDARY_MS=null