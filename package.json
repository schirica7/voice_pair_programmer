{
  "name": "voice-pair-programmer",
  "displayName": "Voice Pair Programmer",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:voice-pair-programmer.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "voice-pair-programmer.toggleSession",
        "title": "Voice Pair Programmer: Toggle Session"
      },
      {
        "command": "voice-pair-programmer.captureContext",
        "title": "Voice Pair Programmer: Capture Context"
      }
    ],
    "configuration": {
      "title": "Voice Pair Programmer",
      "properties": {
        "voicePairProgrammer.backendUrl": {
          "type": "string",
          "default": "http://localhost:3123",
          "description": "Local backend URL used when sending captured IDE context."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "voice-pair-programmer.sidebar",
          "name": "Voice Pair"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "server": "node server/server.mjs",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
